# ==============================================================================
# RESTAURANT SMART POS - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION (Render / Node.js runtime environment)
# NOTE: NEVER expose DATABASE_URL, DIRECT_URL, or JWT_SECRET to the browser!
# ------------------------------------------------------------------------------

# Supabase PostgreSQL Connection String (Transaction Pooler - Port 6543 / PgBouncer)
DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection String (Session / Migration - Port 5432)
DIRECT_URL="postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres"

# Production JWT Secret Key (Generate a random 64+ char string, e.g. via `openssl rand -hex 32`)
JWT_SECRET="replace_with_a_secure_random_64_character_string_for_production"

# Production CORS Whitelist: Set to your production Vercel frontend URL
# Both CORS_ORIGIN and CORS_ORIGINS are supported (comma-separated if multiple)
CORS_ORIGIN="https://YOUR-VERCEL-FRONTEND-URL"
CORS_ORIGINS="https://YOUR-VERCEL-FRONTEND-URL"
CLIENT_URL="https://YOUR-VERCEL-FRONTEND-URL"

# Server runtime environment ('production' or 'development')
NODE_ENV="production"

# Port and Host bindings (Render / Cloud Run default container port is 3000 or $PORT)
PORT="3000"
HOST="0.0.0.0"

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (Vercel Build & Runtime Environment)
# NOTE: Only variables starting with VITE_ are embedded into the client bundle!
# ------------------------------------------------------------------------------

# Centralized Backend API Base URL
# - When frontend & backend are deployed separately (e.g. Vercel + Render):
#   Set this to your live backend domain, e.g. https://YOUR-BACKEND.onrender.com
# - When backend serves the frontend (single container / same-origin): leave empty to default to "/api/v1"
VITE_API_BASE_URL=

# Real-Time WebSocket Server URL (Socket.IO)
# - Set to your backend host, e.g. https://YOUR-BACKEND.onrender.com
# - If left empty, will automatically use the host from VITE_API_BASE_URL or current browser origin
VITE_WS_URL=

# ------------------------------------------------------------------------------
# 3. PLATFORM CONFIGURATION (Optional / Injected by Platform)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
APP_URL=""
