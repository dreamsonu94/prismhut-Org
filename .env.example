# ==============================================================================
# RESTAURANT SMART POS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER-ONLY CONFIGURATION (NEVER expose to browser / client)
# ------------------------------------------------------------------------------
# Supabase PostgreSQL connection string with connection pooling (e.g. Supavisor / PgBouncer)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase direct PostgreSQL connection string (Used for Prisma migrations/schema pushes)
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Production JWT secret key (Generate a 64+ character random secret for production)
JWT_SECRET="replace_with_a_secure_random_64_character_string_for_production"

# Production CORS whitelist (comma-separated origins allowed to make API requests)
# Example: https://pos.myrestaurant.com,https://waiter.myrestaurant.com
CORS_ORIGINS="https://pos.myrestaurant.com"

# Alternative single frontend origin
CLIENT_URL="https://pos.myrestaurant.com"

# Server runtime environment ('production' or 'development')
NODE_ENV="production"

# Port and Host bindings (Port 3000 is standard for container deployments)
PORT="3000"
HOST="0.0.0.0"

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (Vite Client-side Variables)
# ------------------------------------------------------------------------------
# Backend API Base URL
# - For unified deployment (Express serving static frontend): "/api/v1"
# - For separate frontend hosting (Vercel): "https://prismhut-org.onrender.com"
VITE_API_BASE_URL="https://prismhut-org.onrender.com"

# Optional WebSocket URL (defaults automatically to the origin of VITE_API_BASE_URL if left blank)
# Example: "https://prismhut-org.onrender.com"
VITE_WS_URL="https://prismhut-org.onrender.com"

# ------------------------------------------------------------------------------
# 3. CLOUD PLATFORM CONFIGURATION (Optional / Injected by Platform)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
APP_URL=""


